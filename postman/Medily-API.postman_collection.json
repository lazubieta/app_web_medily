{
  "info": {
    "name": "Medily API REST - Evidencias AA2",
    "description": "Pruebas de autenticacion, CRUD JSON, validaciones, errores y consumo de API externa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "deviceId", "value": "1"}
  ],
  "item": [
    {
      "name": "01 - GET listar dispositivos",
      "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/api/devices?search=&brand=&category=", "host": ["{{baseUrl}}"], "path": ["api", "devices"], "query": [{"key": "search", "value": ""}, {"key": "brand", "value": ""}, {"key": "category", "value": ""}]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('GET responde 200', function () { pm.response.to.have.status(200); });", "pm.test('La respuesta es un arreglo JSON', function () { pm.expect(pm.response.json()).to.be.an('array'); });", "pm.test('Incluye campos del producto', function () { pm.expect(pm.response.json()[0]).to.have.property('name'); });"]}}]
    },
    {
      "name": "02 - POST login administrador",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"identity\": \"admin@medily.com\",\n  \"password\": \"Medily2026*\"\n}"}, "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Login responde 200', function () { pm.response.to.have.status(200); });", "pm.test('La sesion queda creada', function () { pm.expect(pm.response.headers.has('Set-Cookie')).to.be.true; });"]}}]
    },
    {
      "name": "03 - POST crear dispositivo",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Dispositivo Postman\",\n  \"brand\": \"Medily\",\n  \"price\": 899000,\n  \"image\": \"https://example.com/medily.jpg\",\n  \"description\": \"Registro creado desde la coleccion de pruebas\",\n  \"releaseDate\": \"2026-09-18\",\n  \"category\": \"Gama media\",\n  \"features\": {\"storage\": \"256 GB\", \"display\": \"6.7 pulgadas\"}\n}"}, "url": {"raw": "{{baseUrl}}/api/devices", "host": ["{{baseUrl}}"], "path": ["api", "devices"]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('POST responde 201', function () { pm.response.to.have.status(201); });", "pm.test('Devuelve el id creado', function () { pm.expect(pm.response.json().id).to.be.a('number'); });", "pm.collectionVariables.set('deviceId', pm.response.json().id);"]}}]
    },
    {
      "name": "04 - PUT actualizar dispositivo",
      "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Dispositivo Postman actualizado\",\n  \"brand\": \"Medily\",\n  \"price\": 949000,\n  \"image\": \"https://example.com/medily-updated.jpg\",\n  \"description\": \"Registro actualizado desde la coleccion de pruebas\",\n  \"releaseDate\": \"2026-09-18\",\n  \"category\": \"Gama media\",\n  \"features\": {\"storage\": \"512 GB\", \"display\": \"6.8 pulgadas\"}\n}"}, "url": {"raw": "{{baseUrl}}/api/devices/{{deviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "devices", "{{deviceId}}"]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('PUT responde 200', function () { pm.response.to.have.status(200); });", "pm.test('El cambio se refleja', function () { pm.expect(pm.response.json().name).to.eql('Dispositivo Postman actualizado'); });"]}}]
    },
    {
      "name": "05 - GET detalle dispositivo",
      "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/api/devices/{{deviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "devices", "{{deviceId}}"]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('GET detalle responde 200', function () { pm.response.to.have.status(200); });"]}}]
    },
    {
      "name": "06 - GET consumo API externa",
      "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/api/external/products", "host": ["{{baseUrl}}"], "path": ["api", "external", "products"]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Endpoint externo responde 200', function () { pm.response.to.have.status(200); });", "pm.test('Controla disponibilidad con fallback', function () { pm.expect(pm.response.json()).to.have.property('fallback'); });"]}}]
    },
    {
      "name": "07 - DELETE eliminar dispositivo",
      "request": {"method": "DELETE", "header": [], "url": {"raw": "{{baseUrl}}/api/devices/{{deviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "devices", "{{deviceId}}"]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('DELETE responde 204', function () { pm.response.to.have.status(204); });"]}}]
    },
    {
      "name": "08 - GET error 404 estructurado",
      "request": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/api/devices/999999999", "host": ["{{baseUrl}}"], "path": ["api", "devices", "999999999"]}},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('El error devuelve 404', function () { pm.response.to.have.status(404); });", "pm.test('El error tiene status y mensaje', function () { pm.expect(pm.response.json()).to.have.property('status', 404); pm.expect(pm.response.json()).to.have.property('message'); });"]}}]
    }
  ]
}
